<% content_for :title, @movie.title %>

<%= link_to "← All movies", movies_path, class: "back-link" %>

<%= render @movie %>

<div class="actions-bar">
  <%= link_to "Edit", edit_movie_path(@movie), class: "button" %>
  <%= button_to "Delete", @movie, method: :delete, class: "button button-ghost-danger",
        form: { class: "inline-form", onsubmit: "return confirm('Delete this movie?')" } %>
</div>

<%= form_with(model: movie, class: "movie-form") do |form| %>
  <% if movie.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= pluralize(movie.errors.count, "error") %> prohibited this movie from being saved:</h2>

      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, placeholder: "e.g. Spirited Away" %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :rating %>
      <%= form.select :rating, MoviesHelper::RATINGS, include_blank: "Choose a rating" %>
    </div>

    <div class="field">
      <%= form.label :release_date %>
      <%= form.date_field :release_date, value: movie.release_date&.to_date %>
    </div>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 5, placeholder: "A short summary of the movie" %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button" %>
    <%= link_to "Cancel", (movie.persisted? ? movie : movies_path), class: "button button-ghost" %>
  </div>
<% end %>

<% content_for :title, "Movies" %>

<div class="page-header">
  <div>
    <h1>Movies</h1>
    <p class="subtitle">Click a column heading to sort. Click it again to reverse the order.</p>
  </div>
  <%= link_to "Add movie", new_movie_path, class: "button" %>
</div>

<div class="table-wrap">
  <table class="movies-table" id="movies">
    <caption class="visually-hidden">Movies, sorted by <%= sort_column.humanize.downcase %> (<%= sort_direction_label %>)</caption>
    <thead>
      <tr>
        <%= sortable_header "title", "Title" %>
        <%= sortable_header "rating", "Rating" %>
        <%= sortable_header "release_date", "Released" %>
        <th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr id="<%= dom_id movie %>">
          <td class="title-cell <%= sorted_class("title") %>"><%= link_to movie.title, movie %></td>
          <td class="<%= sorted_class("rating") %>"><span class="pill"><%= movie.rating %></span></td>
          <td class="muted <%= sorted_class("release_date") %>"><%= formatted_release_date(movie) %></td>
          <td class="actions"><%= link_to "View →", movie, class: "row-link" %></td>
        </tr>
      <% end %>
      <% if @movies.empty? %>
        <tr>
          <td colspan="4" class="empty">No movies yet. <%= link_to "Add the first one", new_movie_path %>.</td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4">
          <div class="table-footer">
            <span><%= pluralize(@movies.size, "movie") %></span>
            <span class="sort-summary sort-summary-<%= sort_direction %>">
              <span class="swatch" aria-hidden="true"></span>
              Sorted by <%= sort_column.humanize.downcase %>, <%= sort_direction_label %>
            </span>
          </div>
        </td>
      </tr>
    </tfoot>
  </table>
</div>

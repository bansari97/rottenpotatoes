<article id="<%= dom_id movie %>" class="movie">
  <h1 class="movie-title"><%= movie.title %></h1>

  <dl class="movie-meta">
    <div>
      <dt>Rating</dt>
      <dd><span class="pill"><%= movie.rating.presence || "—" %></span></dd>
    </div>
    <div>
      <dt>Released</dt>
      <dd><%= formatted_release_date(movie) || "Unknown" %></dd>
    </div>
  </dl>

  <section class="movie-description">
    <h2>Description</h2>
    <p><%= movie.description.presence || "No description yet." %></p>
  </section>
</article>
